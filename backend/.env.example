# ============================================================
# xm3 后端配置
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# ============================================================

# ---------- 应用 ----------
APP_HOST=127.0.0.1
APP_PORT=8020
FRONTEND_ORIGIN=http://localhost:3500
LOG_LEVEL=INFO

# ---------- Provider 选择 ----------
# 切换实现只改这几行 + 填对应凭据，代码零改动。
# 可选值见 app/providers/registry.py 中注册的名字。
# 填 mock 可以完全离线跑通整条流水线（零 API 花费）。
LLM_PROVIDER=deepseek
SEARCH_PROVIDER=bocha
FETCH_PROVIDER=http
# 主 provider 熔断后自动降级到它；留空表示不降级。
LLM_FALLBACK=

# ---------- Provider 凭据 ----------
# 命名约定：<PROVIDER>_API_KEY / <PROVIDER>_BASE_URL / <PROVIDER>_MODEL_{CORE,AUX,FAST}
# 这里没有在 config.py 里为每个 provider 写死字段——凭据是按上面的约定
# 从环境里动态读取的。所以接入一家新 provider 只需要：
#   1) 写一个适配器类（约 10 行）
#   2) 在这里加几行环境变量
# config.py 与流水线都不用动。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 三档模型：core 用于核心章节与关键分析，aux 用于常规章节，fast 用于杂务。
DEEPSEEK_MODEL_CORE=
DEEPSEEK_MODEL_AUX=
DEEPSEEK_MODEL_FAST=
# 可选：模型单价，单位是美元/百万 token，用于成本统计。
# 不填则成本记 0 —— 不估算、不猜：编出来的单价会让整张成本表失去可信度。
# DEEPSEEK_PRICING={"deepseek-chat": [0.27, 1.10]}

# 备用 provider 示例（填了才能用 LLM_FALLBACK=zhipu）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_CORE=
ZHIPU_MODEL_AUX=
ZHIPU_MODEL_FAST=

BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1

# 备用搜索 provider 示例
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# ---------- 网络与限额 ----------
LLM_TIMEOUT=180
LLM_MAX_RETRIES=1
FETCH_TIMEOUT=20
FETCH_MAX_CHARS=20000

# ---------- 测试用录制回放 ----------
# off    = 正常联网（开发默认）
# record = 联网并把每次请求/响应写进 cassette（刻意手动跑，会花钱）
# replay = 只读 cassette，缺失就抛 CassetteMiss，绝不联网（CI 默认）
CASSETTE_MODE=off
CASSETTE_DIR=tests/fixtures/cassettes

# ---------- mock 的行为开关 ----------
# 每次 provider 调用后人为等待的毫秒数。默认 0。
#
# 只在 LLM_PROVIDER=mock 时有意义。mock 快到一整个 quick 任务 0.2 秒跑完，
# 于是**一切跟时间有关的现象都来不及发生**：断网 10 秒再恢复、SSE 心跳、
# 并发订阅的窗口。把它调大，这些才成为可复现的现象，而仍然零成本、零网络。
#
#   演示「跑到一半断网」：1500（一次 quick 运行约 1~1.5 分钟）
#   压测：               0（慢下来的是被测对象之外的噪声）
#
# **演示时请不要写在这个文件里**，而是作为一次性环境变量传给进程：
#
#   MOCK_LATENCY_MS=1500 LLM_PROVIDER=mock .venv/Scripts/python.exe -m uvicorn app.main:app
#
# 原因是 .env 里的值对**测试**同样生效：集成测试会经由 registry 用
# `get_settings()` 构造 provider，于是它们也拿到这个值。实测
# `MOCK_LATENCY_MS=300 pytest tests/integration` 从 10.9 秒变成 172.9 秒
# （16 倍）。症状只是"测试变慢了"，没人会因此去查 mock。
MOCK_LATENCY_MS=0
